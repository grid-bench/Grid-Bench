include README.md LICENSE LICENSE-DATA LICENSE_STATUS.md CITATION.cff CONTRIBUTING.md CHANGELOG.md
include PUBLIC_SOURCE_MANIFEST.json .python-version .gitignore uv.lock
recursive-include .github *.yml
recursive-include docs *.md *.json
